# 统一规则
* text=auto eol=lf
# 代码
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
# shader（重点！）
*.fx   text eol=lf
*.hlsl text eol=lf
# 配置/脚本
*.txt  text eol=lf
*.md   text eol=lf
*.cmake text eol=lf
# 二进制（防止被改）
*.png binary
*.jpg binary
*.dds binary
*.fbx binary
*.exe binary
*.dll binary
*.cpp  text working-tree-encoding=UTF-8 eol=lf
*.h    text working-tree-encoding=UTF-8 eol=lf
*.fx   text working-tree-encoding=UTF-8 eol=lf
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
