# ===== Build output =====
build/
out/

# ===== vcpkg =====
# Submodule build artifacts (External/vcpkg itself IS tracked as submodule)
External/vcpkg/buildtrees/
External/vcpkg/downloads/
External/vcpkg/packages/
External/assimp/
External/Include/*
!External/Include/FontEngine/
External/Library/*
!External/Library/FontEngine/

# Installed packages are reproducible from vcpkg.json — don't commit them
vcpkg_installed/

# ===== VS / CMake generated =====
.vs/
*.suo
*.user
CMakeSettings.json
.cmake/

# ===== Binaries =====
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib

# Re-include vendored FontEngine binaries (negated above by *.dll / *.lib)
!External/Library/FontEngine/**
!External/Include/FontEngine/**

# ===== Runtime output =====
# bin/ is generated by cmake build — not tracked
OutputFile/bin/

# Sponza demo scene (CC BY 4.0, see CREDITS.txt — too large for git)
OutputFile/content/mesh/sponza/
OutputFile/content/mesh/sponza_curtains/

# Shaders are copied from src/ at build time — not tracked here
OutputFile/content/shader/

# ===== OS =====
.DS_Store
Thumbs.db
